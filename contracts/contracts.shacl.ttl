# ProofOps evidence contracts (SHACL). Checked closed-world against ONE incident snapshot,
# which is what lets us say evidence is MISSING rather than merely unknown.
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix po:   <https://example.org/proofops#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# Base contract, declared on all diagnoses: three evidence types, each with provenance.
po:DiagnosisContract a sh:NodeShape ;
    sh:targetClass po:Diagnosis ;
    sh:property [ sh:path po:hasEvidence ; sh:qualifiedValueShape [ sh:class po:TemporalPrecedence ] ;
                  sh:qualifiedMinCount 1 ; sh:message "Missing evidence: TemporalPrecedence" ] ;
    sh:property [ sh:path po:hasEvidence ; sh:qualifiedValueShape [ sh:class po:DependencyPath ] ;
                  sh:qualifiedMinCount 1 ; sh:message "Missing evidence: DependencyPath" ] ;
    sh:property [ sh:path po:hasEvidence ; sh:qualifiedValueShape [ sh:class po:CorroboratingSignal ] ;
                  sh:qualifiedMinCount 1 ; sh:message "Missing evidence: CorroboratingSignal" ] .

# Every evidence item must say where it came from.
po:EvidenceProvenance a sh:NodeShape ;
    sh:targetClass po:Evidence ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:message "Evidence without provenance" ] .

# Fault-specific contract: for change-induced faults (inherited by ConfigurationFault and
# ResourceLimitFault through rdfs:subClassOf), the corroborating signal must be of an allowed type.
po:ChangeInducedContract a sh:NodeShape ;
    sh:targetClass po:ChangeInducedFaultDiagnosis ;
    sh:property [ sh:path ( po:hasEvidence po:signalType ) ;
                  sh:in ( po:ConnectionFailure po:ConnectionPoolExhausted po:ConfigError
                          po:OutOfMemory po:CrashLoop po:MemorySaturation ) ;
                  sh:message "CorroboratingSignal type not allowed for a change-induced fault" ] .
