@prefix po:   <https://example.org/proofops#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://example.org/proofops> a owl:Ontology ; rdfs:label "ProofOps ontology" ;
    rdfs:comment "Generated by scripts/build_ontology.py from Cloud-OpsBench fault_taxonomy/root_cause (Online Boutique)." .
skos:prefLabel a owl:AnnotationProperty . skos:altLabel a owl:AnnotationProperty . skos:definition a owl:AnnotationProperty .

### Taxonomy: Fault > fault class > root cause
po:Fault a owl:Class ; skos:prefLabel "Fault" ; skos:definition "A condition that causes user-visible symptoms." .
po:AdmissionFault a owl:Class ; rdfs:subClassOf po:Fault ; skos:prefLabel "AdmissionFault" ; skos:altLabel "Admission_Fault" ; skos:definition "Kubernetes refuses to create pods (quota exceeded, missing service account)." .
po:rc_missing_service_account a owl:Class ; rdfs:subClassOf po:AdmissionFault ; skos:prefLabel "missing service account" ; skos:altLabel "missing_service_account" .
po:rc_namespace_cpu_quota_exceeded a owl:Class ; rdfs:subClassOf po:AdmissionFault ; skos:prefLabel "namespace cpu quota exceeded" ; skos:altLabel "namespace_cpu_quota_exceeded" .
po:rc_namespace_memory_quota_exceeded a owl:Class ; rdfs:subClassOf po:AdmissionFault ; skos:prefLabel "namespace memory quota exceeded" ; skos:altLabel "namespace_memory_quota_exceeded" .
po:rc_namespace_pod_quota_exceeded a owl:Class ; rdfs:subClassOf po:AdmissionFault ; skos:prefLabel "namespace pod quota exceeded" ; skos:altLabel "namespace_pod_quota_exceeded" .
po:rc_namespace_service_quota_exceeded a owl:Class ; rdfs:subClassOf po:AdmissionFault ; skos:prefLabel "namespace service quota exceeded" ; skos:altLabel "namespace_service_quota_exceeded" .
po:rc_namespace_storage_quota_exceeded a owl:Class ; rdfs:subClassOf po:AdmissionFault ; skos:prefLabel "namespace storage quota exceeded" ; skos:altLabel "namespace_storage_quota_exceeded" .
po:SchedulingFault a owl:Class ; rdfs:subClassOf po:Fault ; skos:prefLabel "SchedulingFault" ; skos:altLabel "Scheduling_Fault" ; skos:definition "Pods are created but no node can run them (affinity, taints, capacity, volumes)." .
po:rc_cpu_capacity_mismatch a owl:Class ; rdfs:subClassOf po:SchedulingFault ; skos:prefLabel "cpu capacity mismatch" ; skos:altLabel "cpu_capacity_mismatch" .
po:rc_memory_capacity_mismatch a owl:Class ; rdfs:subClassOf po:SchedulingFault ; skos:prefLabel "memory capacity mismatch" ; skos:altLabel "memory_capacity_mismatch" .
po:rc_node_affinity_mismatch a owl:Class ; rdfs:subClassOf po:SchedulingFault ; skos:prefLabel "node affinity mismatch" ; skos:altLabel "node_affinity_mismatch" .
po:rc_node_cordon_mismatch a owl:Class ; rdfs:subClassOf po:SchedulingFault ; skos:prefLabel "node cordon mismatch" ; skos:altLabel "node_cordon_mismatch" .
po:rc_node_selector_mismatch a owl:Class ; rdfs:subClassOf po:SchedulingFault ; skos:prefLabel "node selector mismatch" ; skos:altLabel "node_selector_mismatch" .
po:rc_pod_anti_affinity_conflict a owl:Class ; rdfs:subClassOf po:SchedulingFault ; skos:prefLabel "pod anti affinity conflict" ; skos:altLabel "pod_anti_affinity_conflict" .
po:rc_pv_binding_occupied a owl:Class ; rdfs:subClassOf po:SchedulingFault ; skos:prefLabel "pv binding occupied" ; skos:altLabel "pv_binding_occupied" .
po:rc_pvc_access_mode_mismatch a owl:Class ; rdfs:subClassOf po:SchedulingFault ; skos:prefLabel "pvc access mode mismatch" ; skos:altLabel "pvc_access_mode_mismatch" .
po:rc_pvc_capacity_mismatch a owl:Class ; rdfs:subClassOf po:SchedulingFault ; skos:prefLabel "pvc capacity mismatch" ; skos:altLabel "pvc_capacity_mismatch" .
po:rc_pvc_selector_mismatch a owl:Class ; rdfs:subClassOf po:SchedulingFault ; skos:prefLabel "pvc selector mismatch" ; skos:altLabel "pvc_selector_mismatch" .
po:rc_pvc_storage_class_mismatch a owl:Class ; rdfs:subClassOf po:SchedulingFault ; skos:prefLabel "pvc storage class mismatch" ; skos:altLabel "pvc_storage_class_mismatch" .
po:rc_taint_toleration_mismatch a owl:Class ; rdfs:subClassOf po:SchedulingFault ; skos:prefLabel "taint toleration mismatch" ; skos:altLabel "taint_toleration_mismatch" .
po:StartupFault a owl:Class ; rdfs:subClassOf po:Fault ; skos:prefLabel "StartupFault" ; skos:altLabel "Startup_Fault" ; skos:definition "Pods are scheduled but containers cannot start (image pull, secrets, mounts)." .
po:rc_image_registry_dns_failure a owl:Class ; rdfs:subClassOf po:StartupFault ; skos:prefLabel "image registry dns failure" ; skos:altLabel "image_registry_dns_failure" .
po:rc_incorrect_image_reference a owl:Class ; rdfs:subClassOf po:StartupFault ; skos:prefLabel "incorrect image reference" ; skos:altLabel "incorrect_image_reference" .
po:rc_missing_image_pull_secret a owl:Class ; rdfs:subClassOf po:StartupFault ; skos:prefLabel "missing image pull secret" ; skos:altLabel "missing_image_pull_secret" .
po:rc_volume_mount_permission_denied a owl:Class ; rdfs:subClassOf po:StartupFault ; skos:prefLabel "volume mount permission denied" ; skos:altLabel "volume_mount_permission_denied" .
po:RuntimeFault a owl:Class ; rdfs:subClassOf po:Fault ; skos:prefLabel "RuntimeFault" ; skos:altLabel "Runtime_Fault" ; skos:definition "Containers start but are killed or restarted (probes, memory limits)." .
po:rc_container_memory_limit_too_low a owl:Class ; rdfs:subClassOf po:RuntimeFault ; skos:prefLabel "container memory limit too low" ; skos:altLabel "container_memory_limit_too_low" .
po:rc_liveness_probe_incorrect_port a owl:Class ; rdfs:subClassOf po:RuntimeFault ; skos:prefLabel "liveness probe incorrect port" ; skos:altLabel "liveness_probe_incorrect_port" .
po:rc_liveness_probe_incorrect_protocol a owl:Class ; rdfs:subClassOf po:RuntimeFault ; skos:prefLabel "liveness probe incorrect protocol" ; skos:altLabel "liveness_probe_incorrect_protocol" .
po:rc_liveness_probe_incorrect_timing a owl:Class ; rdfs:subClassOf po:RuntimeFault ; skos:prefLabel "liveness probe incorrect timing" ; skos:altLabel "liveness_probe_incorrect_timing" .
po:rc_readiness_probe_incorrect_port a owl:Class ; rdfs:subClassOf po:RuntimeFault ; skos:prefLabel "readiness probe incorrect port" ; skos:altLabel "readiness_probe_incorrect_port" .
po:rc_readiness_probe_incorrect_protocol a owl:Class ; rdfs:subClassOf po:RuntimeFault ; skos:prefLabel "readiness probe incorrect protocol" ; skos:altLabel "readiness_probe_incorrect_protocol" .
po:ServiceRoutingFault a owl:Class ; rdfs:subClassOf po:Fault ; skos:prefLabel "ServiceRoutingFault" ; skos:altLabel "Service_Routing_Fault" ; skos:definition "Pods run but traffic cannot reach them (selector, port, protocol, address)." .
po:rc_service_env_var_address_mismatch a owl:Class ; rdfs:subClassOf po:ServiceRoutingFault ; skos:prefLabel "service env var address mismatch" ; skos:altLabel "service_env_var_address_mismatch" .
po:rc_service_port_mapping_mismatch a owl:Class ; rdfs:subClassOf po:ServiceRoutingFault ; skos:prefLabel "service port mapping mismatch" ; skos:altLabel "service_port_mapping_mismatch" .
po:rc_service_protocol_mismatch a owl:Class ; rdfs:subClassOf po:ServiceRoutingFault ; skos:prefLabel "service protocol mismatch" ; skos:altLabel "service_protocol_mismatch" .
po:rc_service_selector_mismatch a owl:Class ; rdfs:subClassOf po:ServiceRoutingFault ; skos:prefLabel "service selector mismatch" ; skos:altLabel "service_selector_mismatch" .
po:PerformanceFault a owl:Class ; rdfs:subClassOf po:Fault ; skos:prefLabel "PerformanceFault" ; skos:altLabel "Performance_Fault" ; skos:definition "Everything runs but too slowly (CPU overload, network delay or loss)." .
po:rc_node_network_delay a owl:Class ; rdfs:subClassOf po:PerformanceFault ; skos:prefLabel "node network delay" ; skos:altLabel "node_network_delay" .
po:rc_node_network_packet_loss a owl:Class ; rdfs:subClassOf po:PerformanceFault ; skos:prefLabel "node network packet loss" ; skos:altLabel "node_network_packet_loss" .
po:rc_pod_cpu_overload a owl:Class ; rdfs:subClassOf po:PerformanceFault ; skos:prefLabel "pod cpu overload" ; skos:altLabel "pod_cpu_overload" .
po:rc_pod_network_delay a owl:Class ; rdfs:subClassOf po:PerformanceFault ; skos:prefLabel "pod network delay" ; skos:altLabel "pod_network_delay" .
po:InfrastructureFault a owl:Class ; rdfs:subClassOf po:Fault ; skos:prefLabel "InfrastructureFault" ; skos:altLabel "Infrastructure_Fault" ; skos:definition "A cluster component on a node fails (containerd, kubelet, kube-proxy, scheduler)." .
po:rc_containerd_unavailable a owl:Class ; rdfs:subClassOf po:InfrastructureFault ; skos:prefLabel "containerd unavailable" ; skos:altLabel "containerd_unavailable" .
po:rc_kube_proxy_unavailable a owl:Class ; rdfs:subClassOf po:InfrastructureFault ; skos:prefLabel "kube proxy unavailable" ; skos:altLabel "kube_proxy_unavailable" .
po:rc_kube_scheduler_unavailable a owl:Class ; rdfs:subClassOf po:InfrastructureFault ; skos:prefLabel "kube scheduler unavailable" ; skos:altLabel "kube_scheduler_unavailable" .
po:rc_kubelet_unavailable a owl:Class ; rdfs:subClassOf po:InfrastructureFault ; skos:prefLabel "kubelet unavailable" ; skos:altLabel "kubelet_unavailable" .
po:CodeDefect a owl:Class ; rdfs:subClassOf po:Fault ; skos:prefLabel "CodeDefect" ; skos:altLabel "Application_Code_Defect" ; skos:definition "The application's own code misbehaves (wrong return, busy loop, leaks)." .
po:rc_code_artificial_delay a owl:Class ; rdfs:subClassOf po:CodeDefect ; skos:prefLabel "code artificial delay" ; skos:altLabel "code_artificial_delay" .
po:rc_code_busy_loop a owl:Class ; rdfs:subClassOf po:CodeDefect ; skos:prefLabel "code busy loop" ; skos:altLabel "code_busy_loop" .
po:rc_code_excessive_file_reads a owl:Class ; rdfs:subClassOf po:CodeDefect ; skos:prefLabel "code excessive file reads" ; skos:altLabel "code_excessive_file_reads" .
po:rc_code_excessive_file_writes a owl:Class ; rdfs:subClassOf po:CodeDefect ; skos:prefLabel "code excessive file writes" ; skos:altLabel "code_excessive_file_writes" .
po:rc_code_memory_leak a owl:Class ; rdfs:subClassOf po:CodeDefect ; skos:prefLabel "code memory leak" ; skos:altLabel "code_memory_leak" .
po:rc_code_missing_parameter a owl:Class ; rdfs:subClassOf po:CodeDefect ; skos:prefLabel "code missing parameter" ; skos:altLabel "code_missing_parameter" .
po:rc_code_wrong_argument_order a owl:Class ; rdfs:subClassOf po:CodeDefect ; skos:prefLabel "code wrong argument order" ; skos:altLabel "code_wrong_argument_order" .
po:rc_code_wrong_return a owl:Class ; rdfs:subClassOf po:CodeDefect ; skos:prefLabel "code wrong return" ; skos:altLabel "code_wrong_return" .

### Evidence, signals, diagnoses
po:Evidence a owl:Class ; rdfs:subClassOf prov:Entity .
po:TemporalPrecedence a owl:Class ; rdfs:subClassOf po:Evidence ; skos:definition "Cause state existed no later than the first symptom, within a stated tolerance." .
po:DependencyPath a owl:Class ; rdfs:subClassOf po:Evidence ; skos:definition "A path of calls links a symptomatic service to the affected component." .
po:CorroboratingSignal a owl:Class ; rdfs:subClassOf po:Evidence ; skos:definition "A signal of a different kind than the cause agrees." .
po:SignalKind a owl:Class .
po:WarningEvent a owl:NamedIndividual , po:SignalKind ; skos:definition "A Kubernetes Warning event" .
po:PodStatus a owl:NamedIndividual , po:SignalKind ; skos:definition "An abnormal pod status or restarts" .
po:LogError a owl:NamedIndividual , po:SignalKind ; skos:definition "Error lines in application logs" .
po:Alert a owl:NamedIndividual , po:SignalKind ; skos:definition "A monitoring alert" .
po:MetricAnomaly a owl:NamedIndividual , po:SignalKind ; skos:definition "A metric deviating from its baseline" .
po:State a owl:NamedIndividual , po:SignalKind ; skos:definition "A configuration state read from kubectl" .
po:Diagnosis a owl:Class .
po:hasEvidence a owl:ObjectProperty ; rdfs:domain po:Diagnosis ; rdfs:range po:Evidence .
po:diagnosedFault a owl:ObjectProperty ; rdfs:domain po:Diagnosis ; rdfs:range po:Fault .
po:signalKind a owl:ObjectProperty ; rdfs:range po:SignalKind .
po:dependsOn a owl:ObjectProperty , owl:TransitiveProperty ; skos:definition "Service call dependency; transitive, which yields multi-hop paths." .

### Defined classes: the reasoner classifies a diagnosis by its fault class (and so its contract)
po:AdmissionFaultDiagnosis a owl:Class ; owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( po:Diagnosis [ a owl:Restriction ; owl:onProperty po:diagnosedFault ; owl:someValuesFrom po:AdmissionFault ] ) ] .
po:SchedulingFaultDiagnosis a owl:Class ; owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( po:Diagnosis [ a owl:Restriction ; owl:onProperty po:diagnosedFault ; owl:someValuesFrom po:SchedulingFault ] ) ] .
po:StartupFaultDiagnosis a owl:Class ; owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( po:Diagnosis [ a owl:Restriction ; owl:onProperty po:diagnosedFault ; owl:someValuesFrom po:StartupFault ] ) ] .
po:RuntimeFaultDiagnosis a owl:Class ; owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( po:Diagnosis [ a owl:Restriction ; owl:onProperty po:diagnosedFault ; owl:someValuesFrom po:RuntimeFault ] ) ] .
po:ServiceRoutingFaultDiagnosis a owl:Class ; owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( po:Diagnosis [ a owl:Restriction ; owl:onProperty po:diagnosedFault ; owl:someValuesFrom po:ServiceRoutingFault ] ) ] .
po:PerformanceFaultDiagnosis a owl:Class ; owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( po:Diagnosis [ a owl:Restriction ; owl:onProperty po:diagnosedFault ; owl:someValuesFrom po:PerformanceFault ] ) ] .
po:InfrastructureFaultDiagnosis a owl:Class ; owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( po:Diagnosis [ a owl:Restriction ; owl:onProperty po:diagnosedFault ; owl:someValuesFrom po:InfrastructureFault ] ) ] .
po:CodeDefectDiagnosis a owl:Class ; owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( po:Diagnosis [ a owl:Restriction ; owl:onProperty po:diagnosedFault ; owl:someValuesFrom po:CodeDefect ] ) ] .

### Demo individuals for Protege (start HermiT; dx_C06 is inferred to be an AdmissionFaultDiagnosis)
po:fault_C06 a owl:NamedIndividual , po:rc_missing_service_account .
po:dx_C06 a owl:NamedIndividual , po:Diagnosis ; po:diagnosedFault po:fault_C06 .
